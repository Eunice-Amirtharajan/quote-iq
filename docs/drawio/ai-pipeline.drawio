        </mxCell>
        <mxCell id="e3-label" value="MISS" style="edgeLabel;html=1;fontSize=10;fontStyle=1;fillColor=#f8cecc;" vertex="1" connectable="0" parent="e3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;" edge="1" source="fetch-quotation" target="fetch-history" parent="1">
          <mxGeometry relative="1" as="geometry" />
