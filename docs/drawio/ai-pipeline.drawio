        <mxCell id="e8-label" value="HTTPS" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="e8"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;" edge="1" source="Groq" target="zod" parent="1">
          <mxGeometry relative="1" as="geometry" />
