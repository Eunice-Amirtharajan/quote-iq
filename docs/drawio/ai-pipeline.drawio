        <mxCell id="e2-label" value="HIT" style="edgeLabel;html=1;fontSize=10;fontStyle=1;fillColor=#d5e8d4;" vertex="1" connectable="0" parent="e2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" source="cache-check" target="fetch-quotation" parent="1">
