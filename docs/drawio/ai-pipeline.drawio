        <mxCell id="e9-label" value="JSON response" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="e9"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;dashed=1;" edge="1" source="zod" target="parse-error" parent="1">
