<mxfile host="app.diagrams.net" modified="2026-05-31" version="21.0.0">
  <diagram name="AI Pipeline" id="ai-pipeline">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="QuoteIQ — AI Pipeline: Hybrid Recommendation Model" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="327" y="20" width="1000" height="40" as="geometry" />
        </mxCell>

        <!-- START -->
        <mxCell id="start" value="Manager requests&#xa;AI Summary" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="100" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- CACHE CHECK -->
        <mxCell id="cache-check" value="Check AIInsight cache&#xa;(insightType=SUMMARY&#xa;expiresAt &gt; now)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="220" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- CACHE HIT -->
        <mxCell id="cache-hit" value="Return cached&#xa;summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="245" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- FETCH DATA -->
        <mxCell id="fetch-quotation" value="Fetch Quotation&#xa;+ items + createdBy&#xa;(Prisma findUnique)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="390" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="fetch-history" value="Fetch Prior Quotations&#xa;by clientName (case-insensitive)&#xa;last 5, createdAt &lt; current" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="500" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- RULES ENGINE -->
        <mxCell id="rules-zone" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="380" y="380" width="260" height="260" as="geometry" />
        </mxCell>
        <mxCell id="rules-zone-label" value="Rules Engine (computeRecommendation)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="385" width="260" height="25" as="geometry" />
        </mxCell>

        <mxCell id="calc-stats" value="Calculate:&#xa;• approvedCount / rejectedCount&#xa;• avgDealSize&#xa;• dealVsAvgPercent %" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="415" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="rules-decision" value="Apply rules:&#xa;rejectionRate &gt; 60% → RECONSIDER&#xa;approvalRate &gt; 60% AND&#xa;|dealVsAvg| &lt; 20% → PROCEED&#xa;else → FOLLOW_UP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="505" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- BUILD PROMPT -->
        <mxCell id="build-prompt" value="buildPrompt()&#xa;Inject computed as anchor&#xa;Isolate user data in XML tags&#xa;(prompt injection protection)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="430" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- Groq -->
        <mxCell id="Groq" value="Groq API&#xa;(Llama 3.3 70B&#xa;dynamic model resolution)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="560" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- ZOD VALIDATION -->
        <mxCell id="zod" value="Zod validation&#xa;QuotationSummarySchema&#xa;{ summary, recommendation,&#xa;keyPoints, riskFactors }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="670" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- PARSE ERROR -->
        <mxCell id="parse-error" value="Throw InternalServerError&#xa;'AI response could not be parsed'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="695" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- HARD OVERRIDE -->
        <mxCell id="override-check" value="computed ===&#xa;RECONSIDER?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="800" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="force-reconsider" value="Force recommendation&#xa;= RECONSIDER&#xa;(rules override AI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="820" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- PERSIST CACHE -->
        <mxCell id="persist" value="Persist to AIInsight table&#xa;(expiresAt = now + 24h)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="930" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- RETURN -->
        <mxCell id="return" value="Return QuotationSummary&#xa;to resolver → client" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="1040" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- EDGES -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" source="start" target="cache-check" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" source="cache-check" target="cache-hit" parent="1">
