#!/bin/sh
set -e

echo "--- pre-push: backend coverage gate ---"
npm --prefix backend run test:cov -- --coverageThreshold='{"global":{"statements":95,"branches":85,"functions":90,"lines":95}}'

echo "--- pre-push: frontend coverage gate (>95% statements) ---"
npm --prefix frontend run test -- --run --coverage --coverage.thresholds.statements=95 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.lines=95

echo "✓ pre-push checks passed"
