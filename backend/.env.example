# PostgreSQL connection string — get this from Neon DB dashboard (use the Pooled connection string)
DATABASE_URL=""

# Any long random string used to sign JWTs — use `openssl rand -hex 64` to generate
JWT_SECRET=""

# Token expiry — supports formats: 7d, 24h, 30m, 3600s
JWT_EXPIRES_IN="7d"

# Groq API key — https://console.groq.com (free tier, no credit card needed)
GROQ_API_KEY=""

# Password assigned to all users created by `prisma db seed`
# Defaults to `password123` if not set — always set this in production
SEED_PASSWORD=""

PORT=4000

# `development` enables GraphQL playground and introspection
# `production` disables both
NODE_ENV="development"

# Comma-separated list of allowed CORS origins
# e.g. "http://localhost:5173,https://quoteiq.cc"
CORS_ORIGIN="http://localhost:5173"

# Winston log level: error | warn | info | debug
# Defaults to info if not set
LOG_LEVEL="info"

# Mailtrap SMTP — Email Sandbox credentials from mailtrap.io
# Used for status transition notifications (quote submitted, approved, rejected)
MAIL_HOST="sandbox.smtp.mailtrap.io"
MAIL_PORT=2525
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="noreply@quoteiq.cc"

# OpenAI API key
OPENAI_API_KEY=""

# RabbitMQ connection string
# Local dev:  amqp://guest:guest@localhost:5672          (docker-compose up)
# Production: amqps://<user>:<pass>@<host>/<vhost>       (CloudAMQP — get from instance details page)
# Note: vhost = username on CloudAMQP (e.g. amqps://user:pass@host/user)
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# OpenTelemetry — distributed tracing
# Set OTEL_ENABLED=true to send traces to Jaeger (docker-compose up jaeger)
# Jaeger UI: http://localhost:16686
OTEL_ENABLED="false"
OTEL_SERVICE_NAME="quoteiq-backend"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318/v1/traces"

# Supabase Storage — used for uploaded RAG documents (F1a epic)
# Get from Supabase project settings → API
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ClamAV — malware scan sidecar (docker-compose up clamav)
# Default: 127.0.0.1:3310 (local), override to service name in docker-compose
CLAMD_HOST="127.0.0.1"
CLAMD_PORT=3310

# VirusTotal — fallback malware scan when ClamAV is unavailable
# Free tier: 4 requests/minute — get at https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=""
