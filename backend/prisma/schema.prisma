generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SALES_MANAGER
  SALES_REP
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

enum InsightType {
  SUMMARY
  CONVERSION_SCORE
  WIN_LOSS_ANALYSIS
}

model User {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  password      String
  role          Role            @default(SALES_REP)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  quotations    Quotation[]     @relation("CreatedBy")
  statusChanges StatusHistory[]
  documents     Document[]      @relation("UploadedDocuments")
}

model Quotation {
  id              String          @id @default(uuid())
  publicToken     String          @unique @default(uuid())
  quotationNumber String          @unique
  title           String
  clientName      String
  status          QuotationStatus @default(DRAFT)
  notes           String?
  taxRate         Float           @default(0)
  subtotal        Float           @default(0)
  taxAmount       Float           @default(0)
  total           Float           @default(0)

  version         Int             @default(1)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdById     String
  createdBy       User            @relation("CreatedBy", fields:[createdById], references:[id])
  items              QuotationItem[]
  statusHistory      StatusHistory[]
  aiInsights         AIInsight[]
  quotationEmbedding QuotationEmbedding?

  @@index([createdById])
  @@index([status])
  @@index([createdById, status])
}

model QuotationItem {
  id          String    @id @default(uuid())
  description String
  quantity    Float
  unitPrice   Float
  lineTotal   Float
  sortOrder   Int       @default(0)
  quotationId String
  quotation   Quotation @relation(fields:[quotationId], references:[id], onDelete: Cascade)
  @@index([quotationId])
}

model StatusHistory {
  id          String          @id @default(uuid())
  fromStatus  QuotationStatus
  toStatus    QuotationStatus
  note        String?
  changedAt   DateTime        @default(now())
  quotationId String
  quotation   Quotation       @relation(fields:[quotationId], references:[id], onDelete: Cascade)
  changedById String?
  changedBy   User?           @relation(fields:[changedById], references:[id], onDelete: SetNull)
  @@index([quotationId])
}

model AIInsight {
  id          String      @id @default(uuid())
  insightType InsightType
  content     String
  generatedAt DateTime    @default(now())
  expiresAt   DateTime
  quotationId String?
  quotation   Quotation?  @relation(fields:[quotationId], references:[id], onDelete: Cascade)
  @@unique([quotationId, insightType])
  @@index([quotationId])
}

model PlaybookChunk {
  id        String                      @id @default(uuid())
  source    String
  content   String
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                    @default(now())

  @@index([source])
}

enum DocumentStatus {
  PENDING_SCAN     // uploaded, awaiting malware + moderation scan
  SCANNING         // scan in progress
  PENDING_REVIEW   // clean file, text extracted — ready for human review
  READY            // approved for RAG use
  REJECTED         // malware detected or moderation flagged
  FAILED           // processing error (extraction, scan service down, etc.)
}

model Document {
  id            String         @id @default(uuid())
  filename      String
  mimeType      String
  sizeBytes     Int
  storageKey    String         @unique  // Supabase Storage object key
  storageUrl    String                  // public or signed URL
  status        DocumentStatus @default(PENDING_SCAN)
  rejectedReason String?                // populated on REJECTED or FAILED
  uploadedById  String
  uploadedBy    User           @relation("UploadedDocuments", fields: [uploadedById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  chunks        DocumentChunk[]

  @@index([uploadedById])
  @@index([status])
}

model DocumentChunk {
  id         String   @id @default(uuid())
  chunkIndex Int
  content    String
  embedding  Unsupported("vector(1536)")?
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([documentId])
}

model QuotationEmbedding {
  id          String    @id @default(uuid())
  quotationId String    @unique
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  searchText  String
  embedding   Unsupported("vector(1536)")?
  updatedAt   DateTime  @updatedAt
}
