{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test,evals}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "dotenv -e .env.test -- jest --config ./test/jest-e2e.json --forceExit",
    "test:e2e:local": "docker-compose -f docker-compose.test.yml down -v && docker-compose -f docker-compose.test.yml up -d && npx dotenv -e .env.test -- prisma migrate deploy && npx dotenv -e .env.test -- prisma db seed && dotenv -e .env.test -- jest --config ./test/jest-e2e.json --forceExit && docker-compose -f docker-compose.test.yml down -v",
    "seed:rag": "ts-node -r tsconfig-paths/register src/prisma/seed-rag.ts",
    "seed:documents": "npx tsx src/prisma/seed-documents.ts",
    "eval": "tsx evals/run-eval.ts",
    "eval:gate": "tsx evals/check-gate.ts",
    "eval:baseline": "tsx evals/check-gate.ts --update-baseline",
    "test:evals": "jest --rootDir evals",
    "seed:load-test": "npx tsx src/prisma/seed-load-test.ts",
    "seed:load-test:dry": "npx tsx src/prisma/seed-load-test.ts --dry-run"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@golevelup/nestjs-rabbitmq": "^9.1.0",
    "@google/generative-ai": "^0.24.1",
    "@neondatabase/serverless": "^1.2.0",
    "@nestjs/apollo": "^13.2.4",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/graphql": "^13.2.4",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.7",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.118.0",
    "@types/nodemailer": "^8.0.1",
    "@willsoto/nestjs-prometheus": "^6.1.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "graphql": "^16.14.2",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "multer": "^2.4.0",
    "nest-winston": "^1.10.2",
    "nodemailer": "^9.0.4",
    "openai": "^7.39.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^1.1.4",
    "pdfjs-dist": "^6.4.299",
    "prisma": "6.19.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "vitest": "^4.1.4",
    "winston": "^3.19.0",
    "ws": "^8.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.0.0",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^@nestjs/websockets$": "<rootDir>/../test/mocks/nestjs-websockets.mock.ts",
      "^@nestjs/platform-socket.io$": "<rootDir>/../test/mocks/nestjs-platform-socket-io.mock.ts",
      "^pdfjs-dist/legacy/build/pdf\\.mjs$": "<rootDir>/../test/mocks/pdfjs-dist.mock.ts"
    },
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.entity.ts",
      "!**/*.module.ts",
      "!**/*.input.ts",
      "!**/*.resolver.ts",
      "!**/*.controller.ts",
      "!**/seed.ts",
      "!**/seed-ci.ts",
      "!**/seed-rag.ts",
      "!**/seed-load-test.ts",
      "!**/seed-documents.ts",
      "!**/apply-trgm-indexes.ts",
      "!**/explain-baseline.ts",
      "!**/cleanup-e2e-data.ts",
      "!**/main.ts",
      "!**/tracing.ts",
      "!**/correlation-id.middleware.ts",
      "!**/*.decorator.ts",
      "!**/*.spec.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "npx tsx src/prisma/seed-ci.ts"
  }
}
