VITE_API_URL="http://localhost:4000/graphql"   # Backend GraphQL endpoint
VITE_BACKEND_URL="http://localhost:3000"        # Backend base URL for WebSocket connection
VITE_SHOW_DEMO_CREDENTIALS="true"              # Show demo login credentials on the login page (set false for real client deployments)
VITE_UPLOAD_ENABLED="true"                     # Set to "false" in public/demo deployments to hide the Upload PDF button
