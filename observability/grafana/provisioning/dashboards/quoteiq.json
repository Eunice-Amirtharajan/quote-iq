{
  "title": "QuoteIQ Backend",
  "uid": "quoteiq-backend",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "15s",
  "time": { "from": "now-5m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "GraphQL Resolver — Request Rate (req/s)",
      "description": "Rate of resolver calls per second, split by resolver name. Derived from the _count series of the resolver duration histogram.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "rate(graphql_resolver_duration_seconds_count[5m])",
          "legendFormat": "{{resolver}} ({{status}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } }
      }
    },
    {
      "id": 2,
      "title": "GraphQL Resolver p95 Latency (s)",
      "description": "95th-percentile latency per resolver. 'p95 = 0.12s' means 95% of calls finished in under 120ms.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(graphql_resolver_duration_seconds_bucket[5m])) by (le, resolver))",
          "legendFormat": "p95 {{resolver}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }
      }
    },
    {
      "id": 3,
      "title": "Groq Model Calls — Primary vs Fallback",
      "description": "Rate of Groq API calls per second, labelled by model, tier (primary/fallback), and outcome (success/transient_error/error). A rising fallback line means the primary model is degraded.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "rate(groq_model_requests_total[1m])",
          "legendFormat": "{{model}} · {{tier}} · {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } }
      }
    },
    {
      "id": 4,
      "title": "Groq Fallback Rate (%)",
      "description": "Percentage of Groq calls that hit a fallback model (not the primary). Green < 10%, yellow 10–30%, red > 30%. Shows 'No data' until the first AI summary is generated.",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 7, "w": 6, "h": 7 },
      "targets": [
        {
          "expr": "100 * (sum(rate(groq_model_requests_total{tier=\"fallback\"}[5m])) or vector(0)) / (sum(rate(groq_model_requests_total[5m])) > 0)",
          "legendFormat": "Fallback %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 30 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Resolver p50 vs p99 Latency",
      "description": "Median (p50) vs tail (p99) latency. A large gap between p50 and p99 means some requests are much slower than the typical case — worth investigating.",
      "type": "timeseries",
      "gridPos": { "x": 18, "y": 7, "w": 6, "h": 7 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(graphql_resolver_duration_seconds_bucket[5m])) by (le, resolver))",
          "legendFormat": "p50 {{resolver}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(graphql_resolver_duration_seconds_bucket[5m])) by (le, resolver))",
          "legendFormat": "p99 {{resolver}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }
      }
    },
    {
      "id": 6,
      "title": "Node.js Heap Used (MB)",
      "description": "How much of the V8 heap is currently occupied. A rising line that never drops suggests a memory leak.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "nodejs_heap_size_used_bytes / 1024 / 1024",
          "legendFormat": "Heap used MB",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "decmbytes", "color": { "mode": "palette-classic" } }
      }
    },
    {
      "id": 7,
      "title": "Node.js Event Loop Lag (ms)",
      "description": "How long callbacks wait behind scheduled timers. Spikes indicate the event loop was blocked by CPU-heavy work or slow synchronous code.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_seconds * 1000",
          "legendFormat": "Event loop lag ms",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "color": { "mode": "palette-classic" } }
      }
    }
  ]
}
